{
  "name": "@gpellicciotta/support.webapp",
  "version": "0.1.0",
  "description": "Shared visual design system and app starter",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "files": [
    "src/",
    "!src/demo/",
    "!src/index.html",
    "bin/",
    "LICENSE.md",
    "CHANGELOG.md",
    "manifest.json"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "eslint . --fix",
    "test": "vitest run",
    "test:slow": "playwright test",
    "serve": "node scripts/serve.mjs",
    "prepack": "node bin/manifest.mjs",
    "postpack": "node bin/manifest.mjs --remove",
    "test:integration": "vitest run --config vitest.integration.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.5",
    "happy-dom": "^21.0.4",
    "vitest": "^5.1.0"
  },
  "bin": {
    "support-webapp": "bin/cli.mjs"
  },
  "copyright": "Copyright (c) Giovanni Pellicciotta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpellicciotta/support.webapp.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
